# Application Settings
APP_NAME=VulnScan Platform
APP_VERSION=0.1.0
DEBUG=false
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=vulnscan
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=vulnscan

# Redis / Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# HashiCorp Vault
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=CHANGE_ME_IN_PRODUCTION
VAULT_MOUNT_POINT=secret
VAULT_PATH_PREFIX=vulnscan

# Neo4j (Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_IN_PRODUCTION

# Security
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_STRONG_RANDOM_KEY_AT_LEAST_32_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scanning Configuration
SCAN_WORKER_TIMEOUT=3600
MAX_CONCURRENT_SCANS=10
MASSCAN_RATE=1000
NMAP_TIMING=T4

# Plugin Configuration
PLUGIN_DIR=/app/plugins
PLUGIN_TIMEOUT=1800

# Approval Workflow
REQUIRE_APPROVAL_INTRUSIVE=true
REQUIRE_APPROVAL_EXPLOIT=true
